<Window x:Class="LaravelGuardian.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laravel Guardian" Height="600" Width="860"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="LARAVEL GUARDIAN" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14"/>
            <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}"
                    Padding="16,8" Margin="8,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16">
            <TextBlock Text="{Binding Summary}" FontSize="14" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding DetectedTools}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,24,0">
                            <Run Text="{Binding Name, Mode=OneWay}"/>:
                            <Run Text="{Binding Version, Mode=OneWay, TargetNullValue='not found'}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="▶ Start Environment" Command="{Binding StartEnvironmentCommand}" Padding="16,8"/>
                <Button Content="■ Stop" Command="{Binding StopEnvironmentCommand}" Padding="16,8" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding BaseUrl}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#89B4FA"/>
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="Run Tests" Command="{Binding RunTestsCommand}" Padding="16,8" Margin="0,0,8,8"/>
                <Button Content="Discover Routes" Command="{Binding DiscoverRoutesCommand}" Padding="16,8" Margin="0,0,8,8"/>
                <Button Content="Run HTTP Checks" Command="{Binding RunHttpChecksCommand}" Padding="16,8" Margin="0,0,8,8"/>
                <Button Content="Cancel" Command="{Binding CancelRunCommand}" Padding="16,8" Margin="0,0,8,8"/>
                <Button Content="Results" Command="{Binding OpenResultsCommand}" Padding="16,8" Margin="0,0,8,8"/>
                <CheckBox Content="Allow tests on the project's database (unsafe)"
                        IsChecked="{Binding AllowSharedDatabase}"
                        VerticalAlignment="Center" Margin="8,0,0,8" Foreground="#F9E2AF"/>
            </WrapPanel>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="Activity" Foreground="#CDD6F4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <Button Content="Copy all" Click="CopyLog_Click" Padding="12,4"/>
                    <Button Content="Clear" Click="ClearLog_Click" Padding="12,4" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBox Grid.Row="1" x:Name="ActivityBox"
                        IsReadOnly="True" IsReadOnlyCaretVisible="True"
                        AcceptsReturn="True" TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                        Background="#11111B" Foreground="#A6E3A1" SelectionBrush="#45475A"
                        FontFamily="Consolas" BorderThickness="0"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>